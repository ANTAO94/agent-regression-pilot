    "orders/not-shipped-123.trace.json": {
      "required_claims": [
        "final_answer.claims.order_status",
        "final_answer.claims.balance_verified"
      ],
      "assertions": [
        {
          "path": "final_answer.claims.order_status",
          "equals": "not_shipped"
        },
        {
          "path": "final_answer.claims.balance_verified",
          "equals": true
        }
      ],
      "must_call": [
        {
          "tool": "get_order",
          "arguments": {
            "order_id": "123"
          }
        },
        {
          "tool": "get_balance",
          "arguments": {
            "customer_id": "customer-1"
          }
        }
      ],
      "must_not_call": [
        "refund_order"
      ],
      "max_steps": 2
    },
